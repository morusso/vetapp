# Copy this file to .env.production and fill in real values.
# Load it with: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Comma-separated hostnames this backend is served under (no scheme), e.g. vetapp.example.com
ALLOWED_HOSTS=vetapp.example.com
# Comma-separated origins allowed to make cross-origin requests to the API (scheme + host)
CORS_ALLOWED_ORIGINS=https://vetapp.example.com
# Comma-separated origins Django trusts for unsafe (POST/PUT/DELETE) requests, e.g. the admin
CSRF_TRUSTED_ORIGINS=https://vetapp.example.com

# --- Frontend ---
# Public origin the browser calls the API on. Baked into the JS bundle at build
# time, so re-run `docker compose build frontend` whenever this changes.
NEXT_PUBLIC_API_URL=https://vetapp.example.com

# --- Database ---
POSTGRES_DB=vetapp
POSTGRES_USER=vetapp
POSTGRES_PASSWORD=

# --- Email (real SMTP relay — no mailcatcher in production) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@vetapp.example.com

# --- Ollama (local LLM for AI-assisted client messages, optional) ---
OLLAMA_MODEL=qwen2.5:3b-instruct
